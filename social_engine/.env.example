# TBTX social engine. Names only. Values live in Infisical.
# Copy to .env locally. Never commit real values.

# Grok / xAI (preferred). GROK_API_KEY is an alias for XAI_API_KEY.
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_API_URL=https://api.x.ai/v1/chat/completions

# Optional fallback if xAI is unset.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=x-ai/grok-4

# Telegram bot (approval keyboard + webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Venice image generation.
VENICE_API_KEY=
VENICE_API_URL=https://api.venice.ai/api/v1
VENICE_IMAGE_MODEL=venice-sd35

# Postiz. Status is hardcoded to draft in code. Never schedule or publish.
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com
POSTIZ_INTEGRATION_LINKEDIN=
POSTIZ_INTEGRATION_X=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_FACEBOOK=
POSTIZ_INTEGRATION_REDDIT=
POSTIZ_INTEGRATION_YOUTUBE=

# Engine
SOCIAL_ENGINE_FAKE=0
SOCIAL_ENGINE_DB=social_engine.sqlite
SOCIAL_ENGINE_PUBLIC_BASE_URL=
SOCIAL_ENGINE_MEDIA_DIR=media
